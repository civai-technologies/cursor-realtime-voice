# Required — server mints short-lived Realtime tokens; key never goes to the browser.
# Set here or in the web UI at http://127.0.0.1:8787 (Settings).
OPENAI_API_KEY=

# Optional
# OPENAI_REALTIME_VOICE_MODEL=gpt-realtime-mini
# CURSOR_VOICE_TOKEN_PORT=8787

# Optional
OPENAI_REALTIME_VOICE_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_SESSION_TTL_SEC=900
CURSOR_VOICE_TOKEN_PORT=8787
CURSOR_VOICE_HOST=127.0.0.1
